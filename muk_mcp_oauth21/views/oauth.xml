<odoo>
  <record id="view_oauth_client_list" model="ir.ui.view"><field name="name">mcp.oauth.client.list</field><field name="model">mcp.oauth.client</field><field name="arch" type="xml"><list><field name="name"/><field name="client_id"/><field name="auth_method"/><field name="source"/><field name="active"/></list></field></record>
  <record id="view_oauth_client_form" model="ir.ui.view"><field name="name">mcp.oauth.client.form</field><field name="model">mcp.oauth.client</field><field name="arch" type="xml"><form><header><button name="action_rotate_secret" string="Generate / Rotate Client Secret" type="object" invisible="source == 'cimd'"/></header><sheet><group><field name="name"/><field name="client_id"/><field name="active"/><field name="auth_method"/><field name="source" readonly="1"/></group><group><field name="redirect_uris"/><field name="grant_types"/></group><p class="text-muted">Public clients use PKCE without a client secret. Generate a secret for confidential clients. Rotating a secret revokes this client's existing authorizations.</p></sheet></form></field></record>
  <record id="view_oauth_client_secret_show" model="ir.ui.view"><field name="name">mcp.oauth.client.secret.show.form</field><field name="model">mcp.oauth.client.secret.show</field><field name="arch" type="xml"><form create="false" edit="false"><group><field name="secret" widget="CopyClipboardChar"/></group><p>This secret is displayed once. Store it in the OAuth client's private configuration.</p><footer><button string="Close" special="cancel" class="btn-primary"/></footer></form></field></record>
  <record id="action_oauth_clients" model="ir.actions.act_window"><field name="name">OAuth Clients</field><field name="res_model">mcp.oauth.client</field><field name="view_mode">list,form</field><field name="path">mcp-oauth-clients</field></record>
  <record id="view_oauth_grant_list" model="ir.ui.view"><field name="name">mcp.oauth.grant.list</field><field name="model">mcp.oauth.grant</field><field name="arch" type="xml"><list create="false" edit="false"><field name="user_id"/><field name="client_id"/><field name="scope"/><field name="create_date"/><field name="last_used"/><field name="expires_at"/><field name="revoked_at"/><button name="action_revoke" string="Revoke" type="object" invisible="revoked_at"/></list></field></record>
  <record id="view_oauth_grant_form" model="ir.ui.view"><field name="name">mcp.oauth.grant.form</field><field name="model">mcp.oauth.grant</field><field name="arch" type="xml"><form create="false" edit="false"><header><button name="action_revoke" string="Revoke Authorization" type="object" invisible="revoked_at"/></header><sheet><group><field name="user_id"/><field name="client_id"/><field name="scope"/><field name="resource"/><field name="expires_at"/><field name="revoked_at"/></group></sheet></form></field></record>
  <record id="action_oauth_grants" model="ir.actions.act_window"><field name="name">OAuth Authorizations</field><field name="res_model">mcp.oauth.grant</field><field name="view_mode">list,form</field><field name="path">mcp-oauth-grants</field></record>
  <record id="action_my_oauth_grants" model="ir.actions.act_window"><field name="name">My Authorized Applications</field><field name="res_model">mcp.oauth.grant</field><field name="view_mode">list,form</field><field name="domain">[('user_id', '=', uid)]</field></record>
  <menuitem id="menu_oauth_clients" name="OAuth Clients" parent="muk_mcp.menu_mcp_authentication" action="action_oauth_clients" sequence="20" groups="base.group_system"/>
  <menuitem id="menu_oauth_grants" name="OAuth Authorizations" parent="muk_mcp.menu_mcp_authentication" action="action_oauth_grants" sequence="30" groups="base.group_system"/>
</odoo>
